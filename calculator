def calculator(a, b, amal):
    try:
        if amal == "+":
            return a + b
        elif amal == "-":
            return a - b
        elif amal == "*":
            return a * b
        elif amal == "/":
            return a / b
        else:
            return "Noto'g'ri amal!"
    except ZeroDivisionError:
        return "0 ga bo'lish mumkin emas!"

